# Canvas Student MCP — configuration
#
# This server is student-only. Every tool acts as the authenticated student:
# reads use Canvas "/self" endpoints, and writes only ever touch your own work.
#
# Authentication is your Canvas web session, captured from Chrome — there is no
# API token. Many schools disable student token creation, and Canvas's own web
# UI uses the same /api/v1 API with a session cookie, so that is what this
# server uses. Sign in once in the Chrome window the server opens; the captured
# session is stored owner-only under ~/.canvas-mcp/session.json.

# --- Required -------------------------------------------------------------
# Must be https://. The session cookie is sent on every request, so a cleartext
# origin would expose it on the network.
CANVAS_API_URL=https://your-institution.instructure.com/api/v1

# Development escape hatch for Canvas running on this machine. Only permits
# cleartext http:// to a loopback address (localhost, 127.0.0.1, ::1).
# CANVAS_ALLOW_INSECURE_HTTP=false

# --- Browser login --------------------------------------------------------
# The server opens Chrome itself when no session is stored. Chrome 136+ ignores
# remote debugging on the default profile, so it uses a small dedicated profile
# (separate from your everyday browsing) and closes the window once the session
# is captured.
# CANVAS_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CANVAS_CHROME_PROFILE=
# CANVAS_SESSION_FILE=
# Seconds to wait for you to finish signing in (default 180).
# CANVAS_LOGIN_TIMEOUT=180
# Set true on a headless machine: no window is opened, and tools explain that a
# session must be captured elsewhere first.
# CANVAS_AUTH_NO_BROWSER=false

# --- Transport ------------------------------------------------------------
# Default: streamable HTTP on 127.0.0.1:8819, endpoint /mcp. Point your MCP
# client at http://127.0.0.1:8819/mcp.
# Non-loopback binds are refused: the server holds your Canvas session.
#   canvas-mcp-server --transport streamable-http --host 127.0.0.1 --port 8819
#
# For clients that spawn the server themselves, use stdio:
#   canvas-mcp-server --transport stdio

# --- Optional -------------------------------------------------------------
MCP_SERVER_NAME=canvas-api
DEBUG=false
API_TIMEOUT=30
CACHE_TTL=300
MAX_CONCURRENT_REQUESTS=10
TIMEZONE=UTC
INSTITUTION_NAME=Your Institution Name

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_API_REQUESTS=false
LOG_REDACT_PII=true
LOG_ACCESS_EVENTS=false
LOG_EXECUTION_EVENTS=false
AUDIT_LOG_DIR=

# --- Privacy --------------------------------------------------------------
# Anonymization is applied once, at the Canvas client layer. Your own records
# (/users/self, /submissions/self) are exempt, so you always see your real
# name and your own submission content.
ENABLE_DATA_ANONYMIZATION=true
ANONYMIZATION_DEBUG=false

# --- Local student workspace ---------------------------------------------
# Where study guides, notes, drafts and the work journal live. Plain files, on
# your machine only — nothing here is uploaded unless you approve a submission.
# Default: ~/.canvas-mcp/student
# CANVAS_STUDENT_DIR=

# --- Write tools (ON by default in this build) ---------------------------
# These are the only tools that change anything in Canvas. Each one covers
# only your own work, and submit_assignment always returns a preview plus a
# single-use token first — nothing is submitted until you approve it.
# Valid names: submit_assignment, comment_on_my_submission, mark_module_item_done
# Set to an empty value to register none of them.
STUDENT_WRITE_TOOLS=submit_assignment,comment_on_my_submission,mark_module_item_done

# --- Per-course instructor policy ---------------------------------------
# An instructor can block agent writes in their own course by putting plain
# lines in the course syllabus (which students cannot edit):
#   agent_writes: deny
# or, to narrow it:
#   agent_writes: allow
#   allow_tools: submit_assignment
#   note: Allowed for weekly labs. Ask me before using it on the final project.
COURSE_AGENT_POLICY_ENABLED=true
# Posture for a course that states no policy: allow (default) or deny.
COURSE_AGENT_POLICY_DEFAULT=allow
# Cache lifetimes in seconds. Grants are cached briefly on purpose: a stale
# grant is a revocation window on an action that spends your attempts.
COURSE_AGENT_POLICY_ALLOW_TTL=30
COURSE_AGENT_POLICY_DENY_TTL=300

# --- Quiz taking (OFF by default) ----------------------------------------
# Reading quizzes (list_quizzes, get_quiz_details, get_my_quiz_attempts) is
# always available and is unaffected by this flag. Starting, answering and
# submitting an attempt is separate and OFF by default because it consumes one
# of your attempts and produces graded work. This flag is independent of
# STUDENT_WRITE_TOOLS and of every per-course policy.
#
# Only Classic Quizzes can be taken. New Quizzes has no student
# start/answer/submit API in Canvas; those quizzes are listed and read, and the
# taking tools refuse with an explanation rather than faking success.
CANVAS_ENABLE_QUIZ_TAKING=false
